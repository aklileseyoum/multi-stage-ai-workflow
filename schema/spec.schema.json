{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validator handoff spec (Stage 1 → Stage 2 contract)",
  "type": "object",
  "required": ["spec_version", "name", "description", "fields", "cross_field_rules", "examples"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "description": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "rules"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "integer"] },
          "required": { "type": "boolean" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "kind", "params", "message"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
                "kind": { "enum": ["required", "type", "length", "range", "enum", "pattern"] },
                "params": { "type": "object" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "cross_field_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "description", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
          "description": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "expected_errors"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "object" },
          "expected_errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
